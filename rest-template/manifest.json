{
  "id": "rest-template",
  "name": "REST Template",
  "version": "1.0.0",
  "author": "Fiambre",
  "description": "Conecta cualquier API REST que devuelva JSON y renderiza los datos con una plantilla HTML personalizable",
  "wasm": "widget.wasm",
  "min_core_version": "1.0.0",
  "tags": ["api", "rest", "json", "template", "generic"],
  "schema": [
    {"key": "api_url", "label": "URL de la API", "type": "url", "required": true, "default": "", "placeholder": "https://api.example.com/status"},
    {"key": "http_method", "label": "Método HTTP", "type": "select", "options": ["GET", "POST"], "default": "GET", "required": false},
    {"key": "request_body", "label": "Body (JSON, solo si POST)", "type": "textarea", "required": false, "default": "", "placeholder": "{\"key\":\"value\"}"},
    {"key": "auth_token", "label": "Token Bearer (opcional)", "type": "text", "required": false, "default": "", "placeholder": "sk-..."},
    {"key": "template", "label": "Plantilla HTML", "type": "textarea", "required": true, "default": "<div><h3>{{.title}}</h3><p>{{.value}}</p></div>", "placeholder": "Usa {{.campo}}, {{.objeto.subcampo}} o {{range .items}}{{.nombre}}{{end}}"},
    {"key": "poll_seconds", "label": "Intervalo (segundos)", "type": "number", "default": "60"}
  ]
}
